---
import { CATEGORIES } from '../consts';
import { relationLabels } from '../lib/fragments';
const categories = Object.keys(CATEGORIES);
import { writerConfigFromEnv } from '../lib/fragment-writer';
const { config: writerConfig, error: configError } = writerConfigFromEnv(process.env);
---
<dialog id="fragment-composer" aria-labelledby="composer-title" aria-describedby="composer-status" data-writer={writerConfig ? JSON.stringify(writerConfig) : undefined}>
  <div class="composer-heading"><p class="hero__eyebrow">기억하고 싶은 개념</p><button type="button" id="composer-close" aria-label="닫기">닫기 ×</button></div>
  <h2 id="composer-title">새 카드 작성</h2>
  <p id="composer-status" class="fragment-hint" role="status" aria-live="polite">{configError || (writerConfig ? 'GitHub에 로그인하면 카드를 저장할 수 있습니다.' : '작성 화면 미리보기입니다. 저장 기능은 테스트 환경에서 확인할 수 있습니다.')}</p>
  <p class="fragment-hint">새로고침하거나 페이지를 떠나면 입력 내용과 로그인이 사라집니다.</p>
  {writerConfig && <div class="composer-session">
    <p class="fragment-hint">{writerConfig.production ? '저장 대상' : '테스트 저장 대상'}: {writerConfig.repo} / {writerConfig.branch}</p>
    <button type="button" class="btn btn--ghost" id="composer-login">GitHub 로그인</button>
    <button type="button" class="btn btn--ghost" id="composer-logout" hidden>로그아웃</button>
  </div>}
  <form id="composer-form">
    <label>용어<input name="title" required autofocus placeholder="예: 가상 메모리" /></label>
    <label>요약<textarea name="summary" required rows="3" placeholder="이 개념을 짧게 설명해주세요"></textarea></label>
    <label>카테고리<span class="category-select"><select name="category" required aria-label="카테고리">
      <option value="" disabled selected>카테고리를 선택해주세요</option>
      {categories.map(category => <option value={category}>{category}</option>)}
    </select></span></label>
    <div class="composer-columns">
      <label>별칭<input name="aliases" placeholder="쉼표로 구분 · Virtual Memory, VM" /></label>
      <label>태그<input name="tags" placeholder="쉼표로 구분 · 운영체제, 메모리" /></label>
    </div>
    <label>보충 설명<textarea name="body" rows="6" placeholder="예시나 더 자세한 내용을 Markdown으로 남겨보세요"></textarea></label>
    <fieldset id="composer-relations">
      <legend>연결된 개념</legend>
      <p class="fragment-hint">이 카드에서 연결할 카드를 선택하세요. 추가·제거한 관계는 카드를 저장해야 반영됩니다.</p>
      <p class="fragment-hint">같은 두 카드 사이에는 방향·유형과 무관하게 관계 하나만 허용합니다. 이미 연결된 대상은 선택할 수 없습니다. 반대편 카드에서 만든 관계는 해당 카드를 수정해 제거해주세요.</p>
      <input type="hidden" name="relations" id="composer-relation-value" value="[]" />
      <label>관계 카드 검색<input id="composer-relation-search" type="search" placeholder="용어 또는 별칭으로 검색" /></label>
      <label>관계 대상<select id="composer-relation-target"><option value="">카드를 선택해주세요</option></select></label>
      <label>관계 유형<select id="composer-relation-type">{Object.entries(relationLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
      <p class="fragment-hint">선행 개념: 먼저 알아야 할 대상 · 상위 개념: 이 카드가 속한 대상</p>
      <button type="button" class="btn btn--ghost" id="composer-relation-add">관계 추가</button>
      <ul id="composer-relation-list" aria-label="추가한 관계"></ul>
      <p id="composer-relation-notice" class="fragment-hint" aria-live="polite"></p>
    </fieldset>
    <p class="fragment-hint">용어, 요약, 카테고리는 필수 항목입니다. 기존 카드의 ID는 수정 후에도 유지됩니다.</p>
    <div id="composer-error" role="alert" tabindex="-1" hidden>
      <strong id="composer-error-title"></strong>
      <p id="composer-error-message"></p>
      <button type="button" class="btn btn--ghost" id="composer-error-login" hidden>다시 로그인</button>
    </div>
    <div class="composer-actions"><button type="button" class="btn btn--ghost" id="composer-later">닫고 나중에 이어 쓰기</button><button type="button" class="btn btn--ghost" id="composer-delete" hidden aria-describedby="composer-status">카드 삭제</button><button id="composer-save" type="submit" class="btn" disabled aria-describedby="composer-status">카드 저장</button></div>
  </form>
</dialog>
<script>
  import '../scripts/fragment-composer';
</script>
<style>
  dialog { width:min(720px,calc(100vw - 32px)); max-height:calc(100dvh - 48px); overflow:auto; border:1px solid var(--line-strong); border-radius:20px; padding:28px; background:var(--surface); color:var(--ink); box-shadow:var(--shadow-lg); }
  dialog::backdrop { background:rgba(10,10,20,.65); backdrop-filter:blur(5px); }
  :global(body:has(#fragment-composer[open])) { overflow:hidden; }
  h2 { margin:8px 0 12px; font-family:var(--font-display); font-size:30px; }
  .composer-heading,.composer-actions { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .composer-heading p { margin:0; }
  #composer-close { padding:8px 12px; border:1px solid var(--line); border-radius:8px; }
  form { display:grid; gap:18px; margin-top:24px; }
  label { min-width:0; }
  input,textarea,select { width:100%; box-sizing:border-box; background:var(--paper); color:var(--ink); border:1px solid var(--line-strong); border-radius:9px; padding:12px; font:inherit; }
  textarea { resize:vertical; }
  .category-select { position:relative; display:block; }
  .category-select select { appearance:none; padding-right:44px; }
  .category-select::after { content:''; position:absolute; right:18px; top:50%; width:8px; height:8px; border-right:2px solid var(--muted); border-bottom:2px solid var(--muted); transform:translateY(-70%) rotate(45deg); pointer-events:none; }
  @media (forced-colors:active) { .category-select select { appearance:auto; } .category-select::after { display:none; } }
  .composer-columns { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .composer-actions { border-top:1px solid var(--line); padding-top:18px; flex-wrap:wrap; }
  #composer-error { border:2px solid var(--ink); border-radius:12px; padding:16px; background:var(--paper); color:var(--ink); overflow-wrap:anywhere; }
  #composer-error[hidden] { display:none; }
  #composer-error p { margin:8px 0 0; }
  #composer-error-login { margin-top:12px; }
  #composer-error-login[hidden] { display:none; }
  #composer-error:focus { outline:3px solid var(--accent); outline-offset:3px; }
  fieldset { min-width:0; display:grid; gap:12px; border:1px solid var(--line); border-radius:12px; padding:16px; }
  #composer-relation-list { list-style:none; padding:0; margin:0; }
  #composer-relation-list :global(li) { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:8px 0; overflow-wrap:anywhere; }
  #composer-relation-list :global(span) { min-width:0; }
  #composer-relation-list :global(button) { flex-shrink:0; }
  button:disabled { opacity:.45; cursor:not-allowed; }
  .composer-session { padding:12px 0; border-bottom:1px solid var(--line); overflow-wrap:anywhere; }
  input:read-only,textarea:read-only,select:disabled { opacity:.7; }
  @media(max-width:560px) { dialog { padding:20px; } .composer-columns { grid-template-columns:1fr; } }
</style>
