{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fragment-oauth-test",
  "main": "worker.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "OAUTH_SESSIONS", "class_name": "OAuthSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OAuthSession"] }],
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liY7o7sgE1FY7PMd",
    "CMS_ORIGIN": "https://fragment-cms-test.pages.dev",
    "OAUTH_CALLBACK_URL": "https://fragment-oauth-test.rdd0426.workers.dev/callback",
    "GITHUB_SCOPE": "public_repo"
  },
  "observability": { "enabled": false },
  // Production login for https://avocadosmasher.github.io, isolated from the test Worker and OAuth App.
  "env": {
    "production": {
      "name": "fragment-oauth",
      "workers_dev": true,
      "durable_objects": { "bindings": [{ "name": "OAUTH_SESSIONS", "class_name": "OAuthSession" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OAuthSession"] }],
      "vars": {
        "GITHUB_CLIENT_ID": "Ov23liPtP9iKetJ34uCV",
        "CMS_ORIGIN": "https://avocadosmasher.github.io",
        "OAUTH_CALLBACK_URL": "https://fragment-oauth.rdd0426.workers.dev/callback",
        "GITHUB_SCOPE": "public_repo"
      },
      "observability": { "enabled": false }
    }
  }
}
