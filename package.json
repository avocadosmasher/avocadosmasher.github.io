{
  "name": "devlog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "log:new": "node scripts/log-new.mjs",
    "dev:oauth": "wrangler dev --config workers/fragment-oauth/wrangler.jsonc --local",
    "test:oauth": "playwright test --config playwright.oauth.config.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "content:check": "node scripts/content-check.mjs",
    "content:ops": "node scripts/content-ops.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ai-content:build": "node scripts/test-ai-content-build.mjs",
    "test:content-ops:build": "node scripts/test-content-ops-build.mjs",
    "test:git-gates": "vitest run tests/integration/content-git-gates.test.ts --reporter=dot",
    "test:e2e": "playwright test",
    "test:e2e:preview": "node scripts/test-preview.mjs",
    "test": "vitest run",
    "test:h01": "playwright test --config playwright.h01.config.ts",
    "test:h02": "playwright test --config playwright.h02.config.ts",
    "test:draft": "playwright test --config playwright.draft.config.ts"
  },
  "dependencies": {
    "astro": "^5.6.0",
    "cytoscape": "^3.34.3",
    "cytoscape-fcose": "^2.2.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "sanitize-html": "^2.17.7",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.63.0",
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/node": "^22.20.2",
    "@types/sanitize-html": "^2.16.1",
    "decap-server": "^3.11.2",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "4.100.0"
  }
}
